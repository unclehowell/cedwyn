{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cedwyn independent webapp manifest",
  "type": "object",
  "required": [
    "app_id",
    "title",
    "version",
    "release_status",
    "canonical_path",
    "source_branch",
    "app_data_schema_version",
    "catalogue_contract",
    "required_release_checks"
  ],
  "properties": {
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "release_status": {
      "enum": [
        "candidate",
        "ready",
        "released",
        "deprecated"
      ]
    },
    "canonical_path": {
      "type": "string",
      "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*/$"
    },
    "source_branch": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "app_data_schema_version": {
      "type": "string"
    },
    "catalogue_contract": {
      "type": "string",
      "minLength": 1
    },
    "database_binding": {
      "type": [
        "string",
        "null"
      ]
    },
    "health_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_release_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollback_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "change_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "summary"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
