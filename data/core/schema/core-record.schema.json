{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cedwyn.bucklerfamily.estate/_cedwyn/core/core-record.schema.json",
 "title": "Cedwyn core record",
 "version": "0.2.0",
 "description": "One record in the Cedwyn central catalogue (data/core/records/*.json). Public text: neutral third person; provenance names the source document only. 0.2.0 (31 Oct 2026): kind recreation (REC-) with event, description_cited, interpretation_cited, excluded, media, made, version, changes.",
 "type": "object",
 "required": [
  "id",
  "kind",
  "title",
  "public"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^(EV|MR|CC|KF|RET|PL|PE|EVT|AR|TS|OBS|REC)-[A-Z0-9-]+$"
  },
  "kind": {
   "enum": [
    "evidence",
    "artifact",
    "place",
    "person_or_body",
    "event",
    "screening_lead",
    "missing_record",
    "observation",
    "testimony",
    "catalogue_candidate",
    "recreation"
   ]
  },
  "slug": {
   "type": "string",
   "pattern": "^[a-z0-9-]+$"
  },
  "title": {
   "type": "string",
   "minLength": 3,
   "maxLength": 200
  },
  "aliases": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "date": {
   "type": "object",
   "properties": {
    "display": {
     "type": "string"
    },
    "sort": {
     "type": [
      "integer",
      "string",
      "null"
     ]
    },
    "precision": {
     "type": "string"
    }
   }
  },
  "place_text": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "transcript": {
   "type": "string"
  },
  "transcript_status": {
   "type": "string"
  },
  "interpretation": {
   "type": "string"
  },
  "provenance": {
   "type": "object",
   "properties": {
    "holder": {
     "type": "string"
    },
    "reference": {
     "type": "string"
    },
    "date": {
     "type": "string"
    },
    "obtained": {
     "type": "string"
    },
    "independent_origin_id": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "grade": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 0,
   "maximum": 5
  },
  "scope": {
   "type": "object",
   "required": [
    "disposition"
   ],
   "properties": {
    "disposition": {
     "enum": [
      "in_scope",
      "not_this_property",
      "separate_property",
      "out_of_scope",
      "name_correction",
      "dating_correction",
      "assertion_only",
      "context_only",
      "catalogue_only",
      "lead_only",
      "hypothesis",
      "on_hold",
      "outside_title_question",
      "precedent",
      "secondary_copy",
      "unexplained"
     ]
    },
    "label": {
     "type": "string"
    },
    "reason": {
     "type": "string"
    },
    "distinct_from": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "tags": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "places": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "detail": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "heading"
    ],
    "properties": {
     "heading": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "items": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "form": {
      "enum": [
       "section",
       "term"
      ]
     },
     "runs": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "text"
       ],
       "properties": {
        "text": {
         "type": "string"
        },
        "href": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "text"
    ],
    "properties": {
     "text": {
      "type": "string"
     },
     "href": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^/"
     }
    }
   }
  },
  "related": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "links": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "rel",
     "to"
    ],
    "properties": {
     "rel": {
      "type": "string"
     },
     "to": {
      "type": "string"
     }
    }
   }
  },
  "page": {
   "type": "string",
   "pattern": "^/"
  },
  "origin": {
   "type": "string"
  },
  "reworded": {
   "type": "boolean"
  },
  "public": {
   "type": "boolean"
  },
  "updated": {
   "type": "string"
  },
  "rev": {
   "type": "integer"
  },
  "notes": {
   "type": "array",
   "description": "Short paragraphs as runs of text, some linked (root-relative or relative links only).",
   "items": {
    "type": "object",
    "required": [
     "runs"
    ],
    "properties": {
     "class": {
      "enum": [
       "kf-origin",
       "kf-note"
      ]
     },
     "runs": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "text"
       ],
       "properties": {
        "text": {
         "type": "string"
        },
        "href": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "event": {
   "type": "string",
   "description": "recreation: the one event the scene shows"
  },
  "description_cited": {
   "type": "array",
   "description": "recreation: the description built only from verbatim record text, each quotation linked to its catalogue page",
   "items": {
    "type": "object",
    "required": [
     "runs"
    ],
    "properties": {
     "runs": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "text"
       ],
       "properties": {
        "text": {
         "type": "string"
        },
        "href": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     }
    }
   }
  },
  "interpretation_cited": {
   "type": "array",
   "description": "recreation: our interpretation, kept apart from the description",
   "items": {
    "type": "object",
    "required": [
     "runs"
    ],
    "properties": {
     "runs": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "text"
       ],
       "properties": {
        "text": {
         "type": "string"
        },
        "href": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     }
    }
   }
  },
  "excluded": {
   "type": "array",
   "description": "records considered and left out, with the reason",
   "items": {
    "type": "object",
    "required": [
     "text"
    ],
    "properties": {
     "text": {
      "type": "string"
     },
     "href": {
      "type": "string"
     }
    }
   }
  },
  "media": {
   "type": "object",
   "description": "recreation: image paths (photo-real and hologram), size, alt text, label and per-language captions",
   "properties": {
    "photo": {
     "type": "string",
     "pattern": "^/"
    },
    "hologram": {
     "type": "string",
     "pattern": "^/"
    },
    "width": {
     "type": "integer"
    },
    "height": {
     "type": "integer"
    },
    "alt": {
     "type": "string"
    },
    "label": {
     "type": "string"
    },
    "wales": {
     "type": "object"
    },
    "hologram_width": {
     "type": "integer"
    },
    "hologram_height": {
     "type": "integer"
    }
   }
  },
  "made": {
   "type": "object",
   "description": "recreation: how the image was made (model, prompt, date, method of the hologram)",
   "properties": {
    "model": {
     "type": "string"
    },
    "prompt": {
     "type": "string"
    },
    "date": {
     "type": "string"
    },
    "hologram_method": {
     "type": "string"
    },
    "by": {
     "type": "string"
    }
   }
  },
  "version": {
   "type": "string",
   "description": "semantic version of the record"
  },
  "changes": {
   "type": "array",
   "description": "the record's own change log (page journal reads it)",
   "items": {
    "type": "object",
    "properties": {
     "date": {
      "type": "string"
     },
     "rev": {
      "type": "integer"
     },
     "version": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    }
   }
  }
 },
 "additionalProperties": false
}
