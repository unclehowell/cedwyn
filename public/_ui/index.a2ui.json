     }
    },
    {
     "id": "note",
     "component": "Text",
     "text": {
      "path": "/copy/scope_note"
     },
     "className": "kf-scope"
    },
    {
     "id": "links",
     "component": "Inline",
     "className": "kf-scope",
     "separator": " · ",
     "children": {
      "path": "/copy/register_links",
      "componentId": "reglink"
     }
    },
    {
     "id": "reglink",
     "component": "Link",
     "href": {
      "path": "href"
     },
     "text": {
      "path": "text"
     }
    },
    {
     "id": "meta",
     "component": "Text",
     "text": {
      "path": "/copy/meta_text"
     },
     "className": "kf-muted"
    }
   ]
