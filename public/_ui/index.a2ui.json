      "path": "href"
     },
     "kicker": {
      "path": "id"
     },
     "title": {
      "path": "title"
     },
     "meta": [
      {
       "label": "Date",
       "value": {
        "path": "date_display"
       }
      },
      {
       "label": "Place",
       "value": {
        "path": "place_text"
       }
      },
      {
       "label": "Source",
       "value": {
        "path": "source_text"
       }
      }
     ],
     "bodyLabel": {
      "path": "/copy/why_label"
     },
     "body": {
      "path": "why"
     },
     "badge": {
      "path": "status"
     },
     "badgeClass": {
      "path": "status_class"
     },
     "foot": {
      "path": "origin_label"
     },
     "attrs": {
      "st": {
