       },
       "placeholder": {
        "path": "/copy/search_placeholder"
       }
      },
      {
       "kind": "select",
       "id": "kf-s",
       "label": {
        "path": "/copy/status_label"
       },
       "allLabel": {
        "path": "/copy/all"
       },
       "options": {
        "path": "/facets/status"
       }
      },
      {
       "kind": "select",
       "id": "kf-o",
       "label": {
