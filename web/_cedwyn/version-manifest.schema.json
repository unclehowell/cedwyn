{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "/_cedwyn/version-manifest.schema.json",
 "title": "Cedwyn version manifest (standard 1.0.0)",
 "type": "object",
 "required": [
  "standard",
  "version",
  "price_step_gbp",
  "images",
  "ebooks"
 ],
 "properties": {
  "standard": {
   "const": "1.0.0"
  },
  "version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "price_step_gbp": {
   "const": 4.99
  },
  "images": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^/nft-art/art/[a-z0-9.-]+\\.webp$"
   }
  },
  "purchase_path": {
   "type": "string",
   "pattern": "^/"
  },
  "ebooks": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/item"
   }
  },
  "movie": {
   "type": "object"
  },
  "no_gate": {
   "type": "object"
  }
 },
 "$defs": {
  "item": {
   "type": "object",
   "required": [
    "versions"
   ],
   "properties": {
    "card": {
     "type": "string",
     "pattern": "^[a-z0-9-]+$"
    },
    "price": {
     "type": "string",
     "pattern": "^£\\d+\\.\\d{2}$",
     "description": "current price of the LATEST version; earlier prices are computed"
    },
    "unit": {
     "enum": [
      "pages",
      "length"
     ]
    },
    "versions": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "v",
       "date",
       "change"
      ],
      "properties": {
       "v": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+$"
       },
       "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
       },
       "pages": {
        "type": "integer",
        "minimum": 1
       },
       "seconds": {
        "type": "number",
        "minimum": 1
       },
       "kind": {
        "type": "string"
       },
       "change": {
        "type": "string",
        "minLength": 3
       }
      },
      "additionalProperties": false
     }
    }
   },
   "additionalProperties": true
  }
 }
}
